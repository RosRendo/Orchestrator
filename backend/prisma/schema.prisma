datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id            String    @id @default(uuid())
  name          String
  path          String    @unique
  description   String?
  stack         String?   // JSON: ["NestJS","Next.js","PostgreSQL"]
  tags          String?   // JSON: ["trading","backend"]
  deployTargets String?   // JSON: {frontend:"vercel",backend:"vps"}
  agentConfig   String?   // JSON: {preferredAgent:"hermes"}
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  missions      Mission[]
}

model Session {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentType String    // "hermes" | "opencode"
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}

model Mission {
  id          String   @id @default(uuid())
  title       String
  status      String   // "pending" | "running" | "completed" | "failed"
  agentId     String   // "hermes" | "opencode"
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  steps       String?  // JSON string: ["Task analysis", "Agent context loading", "Code edits generated", "Tests passed", "Report generated"]
  codeChanges String?  // JSON string: {"files": ["src/auth.ts"], "additions": 14, "deletions": 2}
  tests       String?  // JSON string: {"passed": true, "summary": "4 unit tests passed"}
  report      String?  // Markdown/Text final agent report
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
